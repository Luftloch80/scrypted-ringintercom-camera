{
    "compilerOptions": {
        "module": "es2022",
        "target": "ES2022",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "types": ["node"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true
    },
    "include": [
        "src/**/*"
    ]
}
