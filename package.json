{
   "name": "@luftloch80/scrypted-ringintercom-camera",
   "version": "0.1.0",
   "description": "Ring Intercom (Klingel, 2-Wege-Audio, Türöffner) kombiniert mit dem Bild einer Reolink-Kamera als ein Türklingel-Gerät in Scrypted.",
   "author": "Luftloch80",
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "https://github.com/Luftloch80/scrypted-ringintercom-camera.git"
   },
   "scripts": {
      "scrypted-setup-project": "scrypted-setup-project",
      "prescrypted-setup-project": "scrypted-package-json",
      "build": "scrypted-webpack",
      "typecheck": "tsc --noEmit",
      "prepublishOnly": "NODE_ENV=production scrypted-webpack",
      "prescrypted-vscode-launch": "scrypted-webpack",
      "scrypted-vscode-launch": "scrypted-deploy-debug",
      "scrypted-deploy-debug": "scrypted-deploy-debug",
      "scrypted-debug": "scrypted-debug",
      "scrypted-deploy": "scrypted-deploy",
      "scrypted-readme": "scrypted-readme",
      "scrypted-package-json": "scrypted-package-json"
   },
   "keywords": [
      "scrypted",
      "plugin",
      "ring",
      "intercom",
      "reolink",
      "doorbell"
   ],
   "scrypted": {
      "name": "Ring Intercom + Reolink Camera",
      "type": "DeviceProvider",
      "interfaces": [
         "DeviceProvider",
         "Settings"
      ],
      "babel": true,
      "pluginDependencies": [
         "@scrypted/prebuffer-mixin",
         "@scrypted/snapshot",
         "@scrypted/webrtc"
      ]
   },
   "dependencies": {
      "ring-client-api": "14.3.0",
      "werift": "^0.22.4"
   },
   "devDependencies": {
      "@scrypted/sdk": "^0.5.59",
      "@types/node": "^22.19.1",
      "terser-webpack-plugin": "^5.6.1",
      "typescript": "^5.9.3"
   }
}
